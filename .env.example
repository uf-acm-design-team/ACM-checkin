# ---------------------------------------------------------------------------
# acm_checkin — development environment template
#
# Copy this file to .env.local and fill in the values:
#
#     cp .env.example .env.local
#
# .env.local is gitignored. Never commit real keys.
#
# This template points at the SHARED HOSTED SUPABASE project (no Docker
# required). If you'd rather run the local Docker stack instead, run
# `npm run setup` — it overwrites .env.local with local Supabase values and
# preserves your Clerk keys.
# ---------------------------------------------------------------------------


# --- Supabase (hosted dev project) -----------------------------------------
# Both values come from the Supabase dashboard:
#   Project Settings -> Data API   (URL)
#   Project Settings -> API Keys   (anon / publishable key)
#
# The anon key is safe to expose to the browser — it is a public key. Do NOT
# put the service_role key in a NEXT_PUBLIC_* variable; it bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Set to true only when running the local Docker stack (npm run setup writes
# this automatically). Nothing reads it today; kept for parity with the setup
# script's output.
# USE_LOCAL_SUPABASE=false

# Service role key — REQUIRED for guest check-in.
#
# Project Settings -> API Keys -> service_role. Bypasses RLS entirely, so it is
# server-only: never prefix it with NEXT_PUBLIC_, never import it into a
# "use client" file. NEXT_PUBLIC_* values are inlined into the browser bundle at
# build time, which would hand every visitor a key that ignores every policy.
#
# Used by app/[orgSlug]/checkin/guest-actions.ts, which performs guest check-in
# server-side because `anon` deliberately has no SELECT on attendees.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# --- Clerk (auth) -----------------------------------------------------------
# Create your own free dev instance at https://dashboard.clerk.com and grab the
# keys from API Keys. Use your OWN dev keys — don't share them between devs.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# Clerk routing — these match the app's actual pages under app/. Leave as-is.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding

# NOTE: the Clerk frontend API host that Supabase needs to verify Clerk JWTs is
# NOT set here — it lives as a literal in supabase/config.toml under
# [auth.third_party.clerk], because the Supabase CLI requires a real hostname
# there and rejects env(...) references. If you point the keys above at a
# different Clerk instance, update that domain to match or Supabase will reject
# your tokens and every RLS policy will deny.


# --- Supabase Edge Functions (optional) -------------------------------------
# There are no edge functions checked in today, so you can ignore this. If you
# add one, its secrets live in supabase/functions/.env (a separate file), not
# here:
#
#     SUPABASE_URL=https://your-project-ref.supabase.co
#     SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# The service_role key bypasses RLS — server/function side only, never in the
# Next.js app.
