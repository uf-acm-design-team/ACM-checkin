# ---------------------------------------------------------------------------
# acm_checkin — development environment template
#
# Copy this file to .env.local and fill in the values:
#
#     cp .env.example .env.local
#
# .env.local is gitignored. Never commit real keys.
#
# This template points at the SHARED HOSTED SUPABASE project (no Docker
# required). If you'd rather run the local Docker stack instead, run
# `npm run setup` — it overwrites .env.local with local Supabase values and
# preserves your Clerk keys.
# ---------------------------------------------------------------------------


# --- Supabase (hosted dev project) -----------------------------------------
# Both values come from the Supabase dashboard:
#   Project Settings -> Data API   (URL)
#   Project Settings -> API Keys   (anon / publishable key)
#
# The anon key is safe to expose to the browser — it is a public key. Do NOT
# put the service_role key in a NEXT_PUBLIC_* variable; it bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Set to true only when running the local Docker stack (npm run setup writes
# this automatically). Nothing reads it today; kept for parity with the setup
# script's output.
# USE_LOCAL_SUPABASE=false

# Service role key — REQUIRED for guest check-in.
#
# Project Settings -> API Keys -> service_role. Bypasses RLS entirely, so it is
# server-only: never prefix it with NEXT_PUBLIC_, never import it into a
# "use client" file. NEXT_PUBLIC_* values are inlined into the browser bundle at
# build time, which would hand every visitor a key that ignores every policy.
#
# Used by app/[orgSlug]/checkin/guest-actions.ts, which performs guest check-in
# server-side because `anon` deliberately has no SELECT on attendees.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# --- Clerk (auth) -----------------------------------------------------------
# Use the SHARED team dev instance — ask a lead for the keys.
#
# Do NOT create your own Clerk instance unless you also edit config.toml (see
# below). Supabase verifies Clerk JWTs against the single literal `domain` in
# supabase/config.toml under [auth.third_party.clerk]. A key from a different
# instance still signs you in — Clerk doesn't care — but Supabase then rejects
# the token, `auth.jwt() ->> 'sub'` is NULL, and every user-scoped RLS policy
# denies. The app looks empty rather than broken, which is a miserable debug.
#
# `npm run setup` checks this for you and prints a mismatch loudly.
#
# If you do need your own instance: set domain = "<your-instance>.clerk.
# accounts.dev" in supabase/config.toml, run `npx supabase stop && npm run
# setup`, and never commit that config.toml change.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# The Clerk frontend API host, with scheme. Read by the app; must belong to the
# same instance as the keys above.
CLERK_FRONTEND_API_DOMAIN=https://your-instance.clerk.accounts.dev

# Clerk routing — these match the app's actual pages under app/. Leave as-is.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding

# --- Supabase Edge Functions ------------------------------------------------
# Two functions are checked in: create-org and update-org-branding. Their
# secrets live in supabase/functions/.env — a SEPARATE file from this one,
# written automatically by `npm run setup`:
#
#     SUPABASE_URL=https://your-project-ref.supabase.co
#     SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# On hosted projects SUPABASE_URL is injected for you, so only the service_role
# key needs setting there: npx supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#
# The service_role key bypasses RLS — server/function side only, never in the
# Next.js app.
